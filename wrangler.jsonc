// Worker 설정 파일
// 대시보드에서 클릭으로 바꾸지 않고, 이 파일로만 설정을 관리합니다.
// (공식 문서: Wrangler로 관리하는 Worker는 Cron도 설정 파일로만 관리하라고 안내)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "status-monitor",
  "main": "src/index.js",

  // 이 날짜 기준의 Workers 런타임 동작을 고정합니다.
  // 너무 미래 날짜면 설치된 wrangler가 경고할 수 있어요 → 공식 문서에서 확인할 부분
  "compatibility_date": "2026-10-01",

  // 5분마다 실행. Cron 시간은 항상 UTC 기준입니다.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  // .sql 파일을 Worker 코드에서 '글자'로 가져오기 위한 규칙 (src/demo-sql.js가 seed/sample.sql을 읽음)
  // 데모 시드를 매일 다시 넣을 때 같은 SQL 파일 한 벌을 그대로 쓰기 위해서입니다.
  // (Text 모듈 규칙 이름·동작 → 공식 문서에서 확인할 부분)
  "rules": [
    { "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }
  ],

  // 상태 페이지 정적 파일(HTML/CSS/JS). public/에 있는 파일은 Cloudflare가 바로 응답하고,
  // 파일이 없는 경로(/api/status 등)만 Worker 코드(fetch)로 넘어옵니다.
  // (정적 파일 설정 이름·동작 → 공식 문서에서 확인할 부분)
  "assets": {
    "directory": "./public"
  },

  "d1_databases": [
    {
      // 코드에서 env.DB 로 접근하는 이름
      "binding": "DB",
      // wrangler 명령에서 쓰는 이름
      "database_name": "status-monitor-db",
      // `npx wrangler d1 create status-monitor-db` 실행 결과로 나온 ID로 채웠습니다.
      // DB를 가리키는 식별자일 뿐 비밀번호가 아니라서 저장소에 올려도 됩니다.
      "database_id": "a22791f6-596d-452b-bead-a55f6b624cc1",
      "migrations_dir": "migrations"
    }
  ]
}
