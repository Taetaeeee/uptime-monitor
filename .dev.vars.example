# 로컬 개발용 비밀 값 예시 (이 파일에는 진짜 값을 넣지 않습니다)
#
# 사용법: 이 파일을 .dev.vars 로 복사한 뒤 값을 채우세요.
#   .dev.vars 는 .gitignore에 들어 있어서 저장소에 올라가지 않습니다. (CLAUDE.md 규칙 3)
# 배포본에는 .dev.vars가 아니라 wrangler secret으로 등록합니다:
#   npx.cmd wrangler secret put AGENT_API_KEY

# 내부 점검 에이전트가 보고할 때 쓰는 키 (Authorization: Bearer <이 값>)
AGENT_API_KEY=여기에_직접_만든_긴_무작위_문자열

# 관리자 API(보고서 작성, 계획 작업 등록·취소) 토큰 — 에이전트 키와 다른 값으로 (B-5)
#   배포본: npx.cmd wrangler secret put ADMIN_TOKEN
ADMIN_TOKEN=여기에_에이전트_키와_다른_긴_무작위_문자열

# AI 장애 조사 — 빈 값이면 유료 호출이 비활성화됩니다.
# 실제 키·토큰은 .dev.vars 또는 서버 secret에만 입력합니다.
OPENAI_API_KEY=
RCA_OPERATOR_TOKEN=
RCA_MODEL=
# 선택한 모델의 공식 요금(USD / 백만 토큰). 입력/출력 모두 필요.
RCA_INPUT_USD_PER_MILLION=
RCA_OUTPUT_USD_PER_MILLION=
RCA_DAILY_USD_LIMIT=
RCA_RUN_USD_LIMIT=
# 실제 점검을 허용할 내 서비스 호스트만 쉼표로 구분. 등록된 real·활성 HTTP 대상과 교집합.
RCA_ALLOWED_HOSTS=

# 오래 가는 장애 메일 (15단계) — 둘 중 하나라도 비어 있으면 메일 기능만 꺼집니다.
#   배포본: npx.cmd wrangler secret put RESEND_API_KEY / npx.cmd wrangler secret put ALERT_EMAIL_TO
RESEND_API_KEY=
# 도메인이 없으면 Resend 가입 메일 주소만 받을 수 있음
ALERT_EMAIL_TO=
# 보내는 주소 (선택). 비우면 Resend 기본 발신 주소
ALERT_EMAIL_FROM=
