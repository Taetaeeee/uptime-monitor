{
  "name": "status-monitor",
  "version": "0.1.0",
  "private": true,
  "description": "Uptime Monitor · 서비스 상태 진단 (포트폴리오용 가상 프로젝트)",
  "type": "module",
  "scripts": {
    "test": "node --test",
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply status-monitor-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply status-monitor-db --remote"
  },
  "devDependencies": {
    "wrangler": "^4.159.0"
  }
}
